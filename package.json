{
  "name": "iotfrontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "chain": "hardhat node",
    "contracts:compile": "hardhat compile",
    "deploy:local": "hardhat run scripts/deploy-log-anchor.cjs --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy-log-anchor.cjs --network sepolia",
    "test:contracts": "hardhat test",
    "test:unit": "vitest run",
    "test": "npm run test:contracts && npm run test:unit"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.2",
    "hardhat": "^2.22.17",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.14",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
